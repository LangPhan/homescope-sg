{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat", "title": "Host CPU used", "id": 1,
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "orange", "value": 0.7}, {"color": "red", "value": 0.85}]}}},
      "targets": [{"expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))", "refId": "A"}]
    },
    {
      "type": "stat", "title": "Host memory used", "id": 2,
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "orange", "value": 0.7}, {"color": "red", "value": 0.85}]}}},
      "targets": [{"expr": "1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "refId": "A"}]
    },
    {
      "type": "stat", "title": "Root disk free", "id": 3,
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "orange", "value": 0.15}, {"color": "green", "value": 0.25}]}}},
      "targets": [{"expr": "node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}", "refId": "A"}]
    },
    {
      "type": "stat", "title": "Healthy probes", "id": 4,
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 1}]}}},
      "targets": [{"expr": "sum(probe_success)", "refId": "A"}]
    },
    {
      "type": "timeseries", "title": "Container CPU", "id": 5,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "fieldConfig": {"defaults": {"unit": "percentunit"}},
      "targets": [{"expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[5m]))", "legendFormat": "{{name}}", "refId": "A"}]
    },
    {
      "type": "timeseries", "title": "Container memory", "id": 6,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "targets": [{"expr": "sum by (name) (container_memory_working_set_bytes{name!=\"\"})", "legendFormat": "{{name}}", "refId": "A"}]
    },
    {
      "type": "stat", "title": "MySQL up", "id": 7,
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 13},
      "targets": [{"expr": "max(mysql_up)", "refId": "A"}]
    },
    {
      "type": "stat", "title": "Redis up", "id": 8,
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 13},
      "targets": [{"expr": "max(redis_up)", "refId": "A"}]
    },
    {
      "type": "timeseries", "title": "MySQL connections", "id": 9,
      "gridPos": {"h": 7, "w": 6, "x": 12, "y": 13},
      "targets": [{"expr": "mysql_global_status_threads_connected", "refId": "A"}]
    },
    {
      "type": "timeseries", "title": "Redis memory", "id": 10,
      "gridPos": {"h": 7, "w": 6, "x": 18, "y": 13},
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "targets": [{"expr": "redis_memory_used_bytes", "refId": "A"}]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["homescope", "infrastructure"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "System Overview",
  "uid": "homescope-system",
  "version": 1
}
